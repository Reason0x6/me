#!/bin/bash

# Get the current branch name
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

# Extract the Jira ticket (assumes it's at the start of the branch name)
JIRA_TICKET=$(echo "$BRANCH_NAME" | grep -oE '^[A-Z]+-[0-9]+' || true)

# Get the commit message file
COMMIT_MSG_FILE=$1

# Read the existing commit message
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# If the message already starts with a Jira ticket, do nothing
if [[ "$COMMIT_MSG" =~ ^[A-Z]+-[0-9]+ ]]; then
    exit 0
fi

# If a Jira ticket was found, prepend it to the commit message
if [[ -n "$JIRA_TICKET" ]]; then
    echo "$JIRA_TICKET $COMMIT_MSG" > "$COMMIT_MSG_FILE"
fi
